{
  "description": "Licence/origin gate. A file passes if it exists at the same path in upstream RXPGuides at upstreamCommit, or matches an 'ours' glob. Files that differ from upstream (and are not excluded from scanning) must not contain forbidden-source markers unless allowlisted with a reason.",
  "upstreamCommit": "22e6ce26e2855ec730d50d40f8a7d5cd733a7327",
  "upstreamRepo": "https://github.com/RestedXP/RXPGuides",
  "ours": [
    { "glob": "docs/**", "origin": "wayfinder", "licence": "CC BY-NC-SA 4.0 (project licence); research data carries per-record provenance" },
    { "glob": "tools/**", "origin": "wayfinder", "licence": "CC BY-NC-SA 4.0 (project licence)" },
    { "glob": "tests/**", "origin": "wayfinder", "licence": "CC BY-NC-SA 4.0 (project licence)" },
    { "glob": "Modules/**", "origin": "wayfinder", "licence": "CC BY-NC-SA 4.0 (project licence)" },
    { "glob": "Data/**", "origin": "wayfinder", "licence": "CC BY-NC-SA 4.0; every record carries a provenance field" },
    { "glob": "Guides/wf/**", "origin": "wayfinder", "licence": "CC BY-NC-SA 4.0 (project licence)" },
    { "glob": "CLAUDE.md", "origin": "wayfinder", "licence": "CC BY-NC-SA 4.0 (project licence)" },
    { "glob": "NOTICE.md", "origin": "wayfinder", "licence": "CC BY-NC-SA 4.0 (project licence)" },
    { "glob": "HANDOFF_README.md", "origin": "wayfinder", "licence": "CC BY-NC-SA 4.0 (project licence)" },
    { "glob": "KICKOFF_PROMPT.md", "origin": "wayfinder", "licence": "CC BY-NC-SA 4.0 (project licence)" },
    { "glob": "package.json", "origin": "wayfinder", "licence": "CC BY-NC-SA 4.0 (project licence)" },
    { "glob": "package-lock.json", "origin": "wayfinder", "licence": "generated by npm; lists dev-only dependencies (not shipped)" },
    { "glob": "tsconfig.json", "origin": "wayfinder", "licence": "CC BY-NC-SA 4.0 (project licence)" },
    { "glob": ".luacheckrc", "origin": "wayfinder", "licence": "CC BY-NC-SA 4.0 (project licence)" },
    { "glob": ".busted", "origin": "wayfinder", "licence": "CC BY-NC-SA 4.0 (project licence)" },
    { "glob": "Wayfinder.toc", "origin": "wayfinder", "licence": "CC BY-NC-SA 4.0; generated by tools/build-toc from upstream RXPGuides.toc (adapted material)" },
    { "glob": ".github/workflows/ci.yml", "origin": "wayfinder", "licence": "CC BY-NC-SA 4.0 (project licence)" }
  ],
  "markerScan": {
    "exclude": ["docs/**"],
    "markers": [
      { "id": "QuestieDB", "regex": "QuestieDB" },
      { "id": "Questie-", "regex": "Questie-" },
      { "id": "QuestieCorrections", "regex": "QuestieCorrections" },
      { "id": "Questie data tables", "regex": "\\b(?:questKeys|npcKeys|objectKeys)\\b" },
      { "id": "cmangos", "regex": "cmangos" },
      { "id": "mangos", "regex": "mangos" },
      { "id": "SimGearForever", "regex": "SimGearForever" },
      { "id": "GNU General Public License", "regex": "GNU\\s+General\\s+Public\\s+License" },
      { "id": "GPL-3", "regex": "\\bGPL[- ]?v?3" }
    ],
    "allow": [
      { "path": "CLAUDE.md", "reason": "Project rules; states the no-GPL rule and names the forbidden sources." },
      { "path": "NOTICE.md", "reason": "Third-party notices; must name the licence of each bundled upstream component, including the GPL ones marked for removal." },
      { "path": "tools/check-origins/origins.json", "reason": "Defines the marker list itself." },
      { "path": "tools/check-origins/index.ts", "reason": "Origin-gate source; names the markers in comments and messages." },
      { "path": "tools/check-origins/index.test.ts", "reason": "Tests of the origin gate need marker strings as fixtures." }
    ]
  }
}
