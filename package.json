{
  "name": "wayfinder-tools",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Node/TypeScript tooling for the Wayfinder addon (not shipped in the addon).",
  "license": "CC-BY-NC-SA-4.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx --test \"tools/**/*.test.ts\"",
    "research:convert": "tsx tools/research-to-md/index.ts",
    "check:manifests": "tsx tools/check-manifests/index.ts",
    "check:origins": "tsx tools/check-origins/index.ts",
    "build:toc": "tsx tools/build-toc/index.ts",
    "check:toc": "tsx tools/build-toc/index.ts --check",
    "inventory:ids": "tsx tools/inventory-ids/index.ts",
    "build:addon": "tsx tools/build-addon/index.ts",
    "check:addon": "tsx tools/build-addon/index.ts --check-residue --check-lines"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "fflate": "0.8.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
